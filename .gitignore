# Qt Creator shadow builds
build/
build-*/
*.qmlc
*.jsc

# Qt Creator per-machine settings — absolute SDK/kit paths, not portable
# between machines, and the usual source of noisy diffs in this project.
CMakeLists.txt.user
CMakeLists.txt.user.*

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Android (Gradle project generated by Qt's android deployer)
.gradle/
local.properties
*.apk
*.aab

# Firmware-update GitHub token baked into local builds (see CMakeLists.txt's
# SKYLINE_GITHUB_TOKEN_FILE) — must never be committed.
github_token.txt

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
